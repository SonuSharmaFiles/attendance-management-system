# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
# These two are sent to the browser. That is expected and safe: Row Level
# Security is what protects the data, not the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. This key bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never commit it, and never paste it into
# client-side code. On Vercel add it as a plain (non-public) Environment Variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Employee session signing ---------------------------------------------
# Signs the employee session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing this value signs every employee out.
EMPLOYEE_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# How long an employee stays signed in, in seconds. Default: 12 hours.
EMPLOYEE_SESSION_TTL_SECONDS=43200

# --- Organisation settings -------------------------------------------------
# Shown in the header, the PDF report and the page title.
NEXT_PUBLIC_ORG_NAME=Your Organisation Name

# Allow employees to change an entry they already saved. Set to false to lock
# attendance once submitted (admins can still correct it).
ATTENDANCE_EDIT_ENABLED=true

# Allow marking dates that have not happened yet. Normally false.
ALLOW_FUTURE_ATTENDANCE=false
